library(ggplot2)
#read in OD 600 measurements
C30<-read.delim('~/Documents/GitHub/amphibian_synthcom/OD600_30.txt', header=T)
C20<-read.delim('~/Documents/GitHub/amphibian_synthcom/OD600_20.txt', header=T)
div<-read.delim('~/Documents/GitHub/amphibian_synthcom/diversity_OD600', header=T)
ab<-read.delim('~/Documents/GitHub/amphibian_synthcom/OD600_AB.txt', header=T)
ggplot(C30, aes(TimePoint, OD600, color=Mucin))+
geom_point()+
facet_wrap(~CarbonSource, scales='free_y')+
geom_smooth()+
theme_bw()+
scale_color_manual(values=c('grey', 'brown'))
